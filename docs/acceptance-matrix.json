    {
      "id": "sdk-event-identities",
      "claim": "Current SDKs assign stable event IDs before first send and preserve them on retry.",
      "status": "verified_locally",
      "proof": [
        { "path": "packages/mobile-core/src/conformance.test.ts", "kind": "tracked" },
        { "path": "sdks/conformance/journey-batch.json", "kind": "tracked" },
        { "path": ".github/workflows/native.yml", "kind": "tracked" }
      ],
      "acceptanceThresholds": {
        "eventIdUniqueness": { "operator": "=", "value": 1, "unit": "per-event identity" },
        "retryIdentityChange": { "operator": "=", "value": 0, "unit": "changed IDs" }
      },
      "nextAction": "Run the native workflow and archive its consumer artifacts."
    },
    {
      "id": "protocol-compatibility",
      "claim": "The ingestion envelope accepts protocol v1 and legacy no-version envelopes while rejecting unsupported future versions.",
      "status": "verified_locally",
      "proof": [
