# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgres://tracki:tracki@localhost:5432/tracki

# Public URL of the dashboard (used in invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tracking snippet served from the ingest origin (slice 1)
NEXT_PUBLIC_SNIPPET_URL=http://localhost:4000/tracki.js

# Ingest origin (help center posts faq_* events here)
NEXT_PUBLIC_INGEST_URL=http://localhost:4000

# Redis (event buffer, key cache, live pub/sub)
REDIS_URL=redis://localhost:6379

# ClickHouse (event analytics store)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=tracki
CLICKHOUSE_PASSWORD=tracki
CLICKHOUSE_DB=tracki

# Ingest service
INGEST_PORT=4000
INGEST_HOST=0.0.0.0
INGEST_RATE_LIMIT=2000
# In dev one process runs both the API and the ClickHouse writer:
INGEST_RUN_WORKER=true
INGEST_RUN_SERVER=true
