{
  "name": "tracki",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "db:generate": "pnpm --filter @tracki/dashboard db:generate",
    "db:migrate": "pnpm --filter @tracki/dashboard db:migrate",
    "ch:migrate": "pnpm --filter @tracki/clickhouse ch:migrate",
    "snippet:build": "pnpm --filter @tracki/snippet build",
    "demo": "pnpm --filter @tracki/demo-site serve",
    "e2e": "pnpm --filter @tracki/e2e e2e",
    "ops:benchmark": "node bench/operations/run.mjs",
    "ops:friction": "node apps/ingest/node_modules/tsx/dist/cli.mjs bench/operations/friction-benchmark.ts",
    "ops:fuzz": "node apps/ingest/node_modules/tsx/dist/cli.mjs bench/operations/adversarial-fuzz.ts",
    "ops:index": "node bench/operations/index-evidence.mjs",
    "ops:preflight": "node bench/operations/preflight-services.mjs",
    "ops:privacy-audit": "node bench/operations/privacy-audit.mjs",
    "ops:verify": "node bench/operations/verify-ci.mjs",
    "ops:reconcile": "node bench/operations/reconcile.mjs",
    "ops:seed": "node apps/ingest/bench/seed-operations.mjs",
    "ops:whatsapp": "node apps/ingest/bench/whatsapp-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "postgres@3.4.9": "patches/postgres@3.4.9.patch"
    }
  }
}
