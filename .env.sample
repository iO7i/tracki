# Tracki production environment — copy to `.env.prod` and fill the blanks.
# Used by infra/docker-compose.prod.yml. NEVER commit the filled .env.prod.
# Generate secrets with e.g.  openssl rand -hex 24

# ── Public domains (must have DNS pointing at this host; Caddy issues TLS) ──
APP_DOMAIN=app.example.com
INGEST_DOMAIN=in.example.com

# ── Browser-visible URLs (baked into the dashboard at BUILD time) ──
# Must be the PUBLIC https origins above.
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_INGEST_URL=https://in.example.com
NEXT_PUBLIC_SNIPPET_URL=https://in.example.com/tracki.js

# ── Server-to-server (dashboard SSR → ingest, internal network) ──
INGEST_URL=http://ingest:4000

# ── Postgres (internal) ──
POSTGRES_USER=tracki
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=tracki
DATABASE_URL=postgres://tracki:CHANGE_ME_postgres@postgres:5432/tracki

# ── ClickHouse (internal) ──
CLICKHOUSE_USER=tracki
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse
CLICKHOUSE_DB=tracki
CLICKHOUSE_URL=http://clickhouse:8123
TELEMETRY_RETENTION_DAYS=90

# ── Redis (internal) ──
REDIS_URL=redis://redis:6379

# ── Ingest service ──
INGEST_PORT=4000
INGEST_HOST=0.0.0.0
INGEST_RATE_LIMIT=2000
INGEST_RUN_SERVER=true
INGEST_RUN_WORKER=true

# ── Runtime ──
NODE_ENV=production

# ── AI (REQUIRED in prod) ──
# Without this the app refuses to boot (assertLLM). The deterministic heuristic
# over-escalates real prose, so a real key is mandatory for production quality.
ANTHROPIC_API_KEY=
# Optional model override (defaults to a current Claude model in code):
# TRACKI_LLM_MODEL=claude-...
# Escape hatch to boot WITHOUT a key (NOT recommended — reduced AI quality):
# TRACKI_ALLOW_HEURISTIC_LLM=1

# ── Platform-staff admin allowlist (comma-separated emails; unset ⇒ nobody) ──
TRACKI_ADMIN_EMAILS=

# ── WhatsApp (optional). Unset ⇒ simulator (dev). For real Meta Cloud API set ALL: ──
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_NUMBER=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
